# ============================================================
# SUPABASE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# ============================================================

# Your Supabase project URL (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase anon/public key (Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============================================================
# OPTIONAL: DIRECT DATABASE CONNECTION (for running SQL migrations)
# Used only by ./run-supabase-sql.sh, never by the browser app
# (it is not VITE_-prefixed, so Vite does not expose it to the client).
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# The "Session pooler" URI works over IPv4.
# ============================================================
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# ============================================================
# PORTFOLIO WEBHOOK (Phase 4)
# URL that receives POST requests when a project is published
# to your external portfolio. Example: a Make/Zapier/n8n webhook
# or your own portfolio API endpoint.
# ============================================================
VITE_PORTFOLIO_WEBHOOK_URL=https://your-portfolio-webhook-url.com/hook

